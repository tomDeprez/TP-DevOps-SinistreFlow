      "title": "Expertises déposées (24 h)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(sinistreflow_expertises_recorded_total[24h]))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "type": "piechart",
      "title": "Usage des versions d'API partenaires (24 h)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (version) (increase(sinistreflow_api_version_requests_total[24h]))",
          "legendFormat": "{{version}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 17,
      "type": "bargauge",
      "title": "Déclarations par type (24 h)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
