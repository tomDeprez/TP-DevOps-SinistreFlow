# Copier en .env puis renseigner. Ne JAMAIS committer le fichier .env (SF-204).
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

DB_HOST=db
DB_PORT=5432
DB_USER=sinistreflow
DB_PASSWORD=
DB_NAME=sinistreflow

BACKOFFICE_USER=gestionnaire
BACKOFFICE_PASSWORD=

# jeton exigé par /metrics (Prometheus l'envoie en Bearer). Vide = /metrics ouvert (à filtrer par nginx)
METRICS_TOKEN=

# image applicative utilisée par docker compose (CI : ghcr.io/<org>/sinistreflow:<sha>)
APP_IMAGE=sinistreflow:local
APP_PORT=3000

# Grafana
GRAFANA_ADMIN_PASSWORD=
