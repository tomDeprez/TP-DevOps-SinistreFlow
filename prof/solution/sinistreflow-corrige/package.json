{
  "name": "sinistreflow",
  "version": "3.4.2",
  "description": "SinistreFlow - plateforme de déclaration et de suivi des sinistres MutuAlp Assurances",
  "main": "src/index.js",
  "private": true,
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --selectProjects unit --coverage",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:e2e": "playwright test",
    "test:partner": "python3 partner-client/expertauto_sync.py"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/unit/**/*.test.js"
        ]
      },
      {
        "displayName": "integration",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/integration/**/*.test.js"
        ],
        "setupFiles": [
          "<rootDir>/tests/integration/env.js"
        ]
      }
    ],
    "collectCoverageFrom": [
      "src/domain/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 90,
        "branches": 80
      }
    }
  }
}
